{
  "name": "reaper-remote-bandui",
  "version": "0.0.0",
  "description": "Web UI for REAPER's remote control interface, to mix and control playback from phones in a band (deprecated, see reaper-bandcontrol)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "check": "biome check .",
    "tsc": "tsc --noEmit",
    "build": "vite build",
    "serve": "vite preview",
    "test:e2e": "playwright test",
    "fix": "biome check --write ."
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/deep-equal": "^1.0.4",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vite-plugin-solid": "^2.11.15"
  },
  "dependencies": {
    "deep-equal": "^2.2.3",
    "solid-js": "^1.9.18"
  },
  "engines": {
    "node": ">=24"
  }
}
